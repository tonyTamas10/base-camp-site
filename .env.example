# Copy to .env.local for local development. Never commit real values.
# In production these are set in the hosting provider's environment settings.

# --- Content -------------------------------------------------------------

# Postgres connection. Locally, `pnpm db` runs one at this address.
# Leave unset to run the site on generated sample content, without the admin.
DATABASE_URI=postgres://basecamp:basecamp@localhost:5433/basecamp

# Signs admin sessions. Use a long random value in production (e.g. `openssl rand -hex 32`).
PAYLOAD_SECRET=change-me

# Force the sample content even when a database is configured: "sample".
# CONTENT_SOURCE=sample

# File uploads go to Vercel Blob when set; otherwise to the local media/ folder.
# BLOB_READ_WRITE_TOKEN=

# --- Site ----------------------------------------------------------------

# Public address of the site (canonical URLs, sitemap, link previews).
SITE_URL=http://localhost:3000

# Fallback address for the contact page (editors can set it in Site settings).
CONTACT_EMAIL=hello@basecamp.example

# --- Development and tests only -----------------------------------------------

# Pins "today" (YYYY-MM-DD) so event statuses don't drift. Tests use 2026-09-24.
# SITE_TODAY=2026-09-24

# `pnpm seed` creates this admin account if there are no users yet.
# SEED_ADMIN_EMAIL=admin@basecamp.test
# SEED_ADMIN_PASSWORD=
